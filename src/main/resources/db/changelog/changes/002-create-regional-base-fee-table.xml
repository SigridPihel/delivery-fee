<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-create-regional-base-fee-table" author="sigrid">
        <createTable tableName="regional_base_fee">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="city" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="vehicle_type" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="fee" type="decimal(5, 2)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="regional_base_fee"
                             columnNames="city, vehicle_type"
                             constraintName="uq_regional_base_fee_city_vehicle_type"/>

        <sql>
            ALTER TABLE regional_base_fee
                ADD CONSTRAINT chk_regional_base_fee_positive CHECK (fee > 0);
        </sql>
    </changeSet>

</databaseChangeLog>