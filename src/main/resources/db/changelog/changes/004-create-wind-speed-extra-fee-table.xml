<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="004-create-wind-speed-extra-fee-table" author="sigrid">
        <createTable tableName="wind_speed_extra_fee">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="vehicle_type" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="fee" type="decimal(5, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="min_wind_speed" type="decimal(4, 1)">
                <constraints nullable="false"/>
            </column>
            <column name="max_wind_speed" type="decimal(4, 1)"/>
        </createTable>

        <sql><![CDATA[
            ALTER TABLE wind_speed_extra_fee
                ADD CONSTRAINT chk_wind_speed_extra_fee_positive
                    CHECK (fee > 0);
            ALTER TABLE wind_speed_extra_fee
                ADD CONSTRAINT chk_wind_speed_extra_fee_min_less_than_max
                    CHECK (min_wind_speed < max_wind_speed);
            ALTER TABLE wind_speed_extra_fee
                ADD CONSTRAINT chk_wind_speed_extra_fee_min_non_negative
                    CHECK (min_wind_speed >= 0);
            ]]></sql>
    </changeSet>

</databaseChangeLog>